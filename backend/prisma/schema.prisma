// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified Boolean       @default(false)
  password      String
  googleId      String?
  name          String?
  gender        String?
  birthDate     Int?
  // UI language preference ('en' | 'ru'). Chosen during the profile survey,
  // editable in profile settings. Defaults to English.
  language      String        @default("en")
  // Stable personal invite token. Minted on first request and reused, so a link
  // the user already shared keeps working (mirrors TestResult.shareToken).
  inviteToken   String?       @unique
  refreshTokens RefreshToken[]
  otpCode       OtpCode?
  testsResults  TestResult[]
  testsProgress TestProgress[]
  portrait      Portrait?
  recommendations RecommendationItem[]
  sentFriendships     Friendship[]    @relation("SentFriendships")
  receivedFriendships Friendship[]    @relation("ReceivedFriendships")
  compatibilitiesA    Compatibility[] @relation("CompatibilitiesA")
  compatibilitiesB    Compatibility[] @relation("CompatibilitiesB")
  chats               Chat[]
}

// One row per active session (device/login). userId is intentionally NOT unique —
// a user can hold several refresh tokens at once. `token` (the HMAC of the JWT) is
// the unique lookup key; rotation/logout delete a single row by token.
model RefreshToken {
  id     String @id @default(cuid())
  userId String
  token  String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  // Failed verification attempts; the code is dropped once this hits the limit
  // (see MailService) so a 6-digit code can't be brute-forced within its TTL.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Test {
  id             String        @id @default(cuid())
  testName       String
  testType       String        @unique
  description    String
  duration       Int
  totalQuestions Int
  questions      TestQuestion?
  testResults    TestResult[]
  testsProgress  TestProgress[]
}

model TestQuestion {
  id        String @id @default(cuid())
  testId    String @unique
  questions Json
  test      Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestResult {
  id             String  @id @default(cuid())
  userId         String
  testId         String
  testType       String
  result         Json
  // Stable public token for sharing this result. Minted on first share and kept
  // across retakes, so a link the user already sent keeps working.
  shareToken     String? @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  test           Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
}

// In-progress answers for a test taken in fragments ("approaches") instead of one
// submit — e.g. Personality's 4 parts of 30. Holds the cumulative answers from
// the fragments completed so far and how many parts are done. The whole test is
// still scored once, after the final fragment, at which point this row is deleted
// and a TestResult is written. One row per (user, test) while in progress.
model TestProgress {
  id        String   @id @default(cuid())
  userId    String
  testId    String
  testType  String
  answers   Json // cumulative AnswerDto[] across completed fragments
  parts     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
}

// AI-synthesized portrait across all of a user's test results. One per user.
// Generated once the first 4 tests are done (`basedOn` = those tests), and
// regenerated when all 6 are complete (`basedOn` grows to the full set).
model Portrait {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   String // markdown
  basedOn   String[] // test types this portrait was synthesized from
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MediaType {
  FILM
  BOOK
}

enum RecommendationVerdict {
  PENDING
  LIKED
  DISLIKED
}

// One AI-recommended film/book for a user. `PENDING` rows are the not-yet-swiped
// queue the frontend shows one at a time; `LIKED`/`DISLIKED` rows are the swipe
// history fed back into later generations. Cleared per `mediaType` on reset.
model RecommendationItem {
  id         String                @id @default(cuid())
  userId     String
  mediaType  MediaType
  verdict    RecommendationVerdict @default(PENDING)
  externalId String // catalog id, e.g. "tmdb:603" or "gbooks:zyTCAlFPjgYC"
  title      String
  posterUrl  String
  synopsis   String                @default("")
  year       Int? // films
  author     String? // books
  extra      Json? // genres, rating, external url, etc.
  order      Int                   @default(0) // position within its generation batch
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt // bumped on swipe — drives history ordering
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mediaType, verdict])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Directed friendship row. `requester` sent the request, `addressee` received it.
// One row per ordered pair; helpers match the pair in both directions. A pair is
// friends once `status` is ACCEPTED.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("ReceivedFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Cached AI compatibility for a pair. Stored in canonical order (userAId < userBId)
// so there's one row per pair regardless of who requested it. Only generated once
// both users have completed every test; deleted on either user's retake (TestsService).
model Compatibility {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  content   String // markdown analysis from the model
  score     Int // 0–100, for the visual ring
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userA     User     @relation("CompatibilitiesA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("CompatibilitiesB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

enum ChatKind {
  PORTRAIT
  COMPATIBILITY
}

enum ChatRole {
  USER
  ASSISTANT
}

// An AI conversation owned by `userId`. Two kinds, both singletons per context so
// chats can't be created freely (enforced in ChatService.getOrCreate*):
//   - PORTRAIT      — one per user; `friendId` is null. Discuss your own portrait.
//   - COMPATIBILITY — one per (user, friend) pair; `friendId` is the other user.
// `friendId` is a plain user id (not a FK relation) — a compatibility chat is the
// viewer's, scoped to a friend, and survives even if that friend later unfriends.
// "Delete history" wipes the messages (cascade) but keeps the chat row.
model Chat {
  id        String        @id @default(cuid())
  userId    String
  kind      ChatKind
  friendId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

// One turn in a chat. Persisted as they complete — the user message before the
// model runs, the assistant message once its stream finishes.
model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}
