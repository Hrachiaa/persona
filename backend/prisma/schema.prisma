// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified Boolean       @default(false)
  password      String
  googleId      String?
  name          String?
  gender        String?
  birthDate     Int?
  refreshToken  RefreshToken?
  otpCode       OtpCode?
  testsResults  TestResult[]
  portrait      Portrait?
  recommendations RecommendationItem[]
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String @unique
  token  String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Test {
  id             String        @id @default(cuid())
  testName       String
  testType       String        @unique
  description    String
  duration       Int
  totalQuestions Int
  questions      TestQuestion?
  testResults    TestResult[]
}

model TestQuestion {
  id        String @id @default(cuid())
  testId    String @unique
  questions Json
  test      Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestResult {
  id             String  @id @default(cuid())
  userId         String
  testId         String
  testType       String
  result         Json
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  test           Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
}

// AI-synthesized portrait across all of a user's test results. One per user.
// Generated once the first 4 tests are done (`basedOn` = those tests), and
// regenerated when all 6 are complete (`basedOn` grows to the full set).
model Portrait {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   String // markdown
  basedOn   String[] // test types this portrait was synthesized from
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MediaType {
  FILM
  BOOK
}

enum RecommendationVerdict {
  PENDING
  LIKED
  DISLIKED
}

// One AI-recommended film/book for a user. `PENDING` rows are the not-yet-swiped
// queue the frontend shows one at a time; `LIKED`/`DISLIKED` rows are the swipe
// history fed back into later generations. Cleared per `mediaType` on reset.
model RecommendationItem {
  id         String                @id @default(cuid())
  userId     String
  mediaType  MediaType
  verdict    RecommendationVerdict @default(PENDING)
  externalId String // catalog id, e.g. "tmdb:603" or "gbooks:zyTCAlFPjgYC"
  title      String
  posterUrl  String
  synopsis   String                @default("")
  year       Int? // films
  author     String? // books
  extra      Json? // genres, rating, external url, etc.
  order      Int                   @default(0) // position within its generation batch
  createdAt  DateTime              @default(now())
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mediaType, verdict])
}
